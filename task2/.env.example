# ------------------------------------------------------------------
# Voice-Enabled RAG — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Everything here has a sensible local default; only set what you need.
# ------------------------------------------------------------------

# --- Embeddings (offline; model auto-downloads on first index build) ---
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Retrieval ---
# DENSE_TOP_K=20
# BM25_TOP_K=20
# FUSION_TOP_K=10
# RRF_K=60
# MIN_RETRIEVAL_CONFIDENCE=0.20

# --- Reranking ---
# The default cross-encoder is English-focused and measurably degrades
# Hindi retrieval (see README §10). Leave off unless you swap in a
# multilingual reranker.
# RERANKER_ENABLED=false
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Answer generation: mock | openai | groq | sarvam | gemini ---
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Speech-to-text: mock | sarvam | elevenlabs ---
STT_PROVIDER=mock
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v1
# SARVAM_LANGUAGE_CODE=hi-IN
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1

# --- Serving ---
# HOST=0.0.0.0
# PORT=8000
