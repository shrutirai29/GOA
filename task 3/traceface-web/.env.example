# TraceFace — Environment Configuration
# Copy this file to .env.local and fill in your values.

# ─── Search Provider ────────────────────────────────────────────
# Get a key from https://serpapi.com for real reverse image search
# Leave empty for demo mode (clearly labeled, no fake results)
SEARCH_PROVIDER=serpapi
SERPAPI_KEY=

# ─── Blockchain ─────────────────────────────────────────────────
# Options: "local" | "testnet" | "demo"
# "demo" = simulated blockchain (clearly labeled)
# "local" = connect to local Hardhat node
# "testnet" = connect to public EVM testnet
BLOCKCHAIN_MODE=demo

# RPC endpoint (for local or testnet mode)
# Local Hardhat: http://127.0.0.1:8545
# Base Sepolia: https://sepolia.base.org
# Polygon Amoy: https://rpc-amoy.polygon.technology
RPC_URL=http://127.0.0.1:8545

# Private key for signing transactions (testnet/local only)
PRIVATE_KEY=

# Deployed EvidenceRegistry contract address
CONTRACT_ADDRESS=

# ─── Face Detection ─────────────────────────────────────────────
# Minimum face match similarity threshold (0.0 - 1.0)
FACE_MATCH_THRESHOLD=0.75
