# TraceFace Configuration
# Copy this file to .env and fill in your values

# Search Provider Configuration
# Options: serpapi, bing, tineye, demo
SEARCH_PROVIDER=demo
SEARCH_API_KEY=

# Blockchain Configuration
# Options: local, testnet
BLOCKCHAIN_MODE=local

# For testnet mode (Base Sepolia, Polygon Amoy, etc.)
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=
CONTRACT_ADDRESS=

# For local mode (Hardhat node)
LOCAL_RPC_URL=http://127.0.0.1:8545

# Face Recognition
FACE_MATCH_THRESHOLD=0.80

# Application
APP_HOST=0.0.0.0
APP_PORT=8501
