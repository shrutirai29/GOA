// ============================================================================
// TigerGraph Schema Definition: Fraud Investigation & Case Memory
// Hacker House Goa 2026 - Task 4
// ============================================================================

CREATE GRAPH FraudInvestigatorGraph()

// ----------------------------------------------------------------------------
// Vertices
// ----------------------------------------------------------------------------

CREATE VERTEX Customer (
    PRIMARY_ID id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
    PRIMARY_ID id STRING,
    issuer_card1 INT,
    card_network STRING,
    card_type STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Transaction (
    PRIMARY_ID id STRING,
    amt DOUBLE,
    ts DATETIME,
    product_cd STRING,
    channel STRING,
    risk_score DOUBLE,
    addr1 STRING,
    addr2 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID id STRING,
    device_info STRING,
    os STRING,
    browser STRING,
    screen STRING,
    proxy_status STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID id STRING,
    addr1 STRING,
    addr2 STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID id STRING,
    domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    n_txns INT,
    actions_taken STRING,
    report_filed STRING,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX CaseVertex (
    PRIMARY_ID id STRING,
    case_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    status STRING,
    verdict STRING,
    pattern STRING,
    pattern_description STRING,
    fraud_probability DOUBLE,
    exposure_usd DOUBLE,
    sar_filed BOOL,
    stop_reason STRING,
    summary STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// ----------------------------------------------------------------------------
// Edges
// ----------------------------------------------------------------------------

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY";
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="CHARGED_ON";
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="USED_IN_TXN";
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_TXNS";
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_TXNS";
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction);

CREATE DIRECTED EDGE CLOSED_INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="IN_CLOSED_CASE";
CREATE DIRECTED EDGE CLOSED_ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_CLOSED_CASES";
CREATE DIRECTED EDGE CLOSED_CONNECTED (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CLOSED_CASES";

CREATE DIRECTED EDGE CASE_INVOLVES (FROM CaseVertex, TO Transaction) WITH REVERSE_EDGE="IN_ACTIVE_CASE";
CREATE DIRECTED EDGE CASE_ON_CARD (FROM CaseVertex, TO Card) WITH REVERSE_EDGE="CARD_ACTIVE_CASES";
CREATE DIRECTED EDGE CASE_CONNECTED_CARD (FROM CaseVertex, TO Card) WITH REVERSE_EDGE="CONNECTED_TO_CASE";
CREATE DIRECTED EDGE CASE_DEVICE (FROM CaseVertex, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_ACTIVE_CASES";
